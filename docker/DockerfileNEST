
#
# TVB-multiscale (NEST, NETPYNE (NEURON), ANNarchy) simulations environment
#
# Install NEST from Docker registry, then the rest of tvb-multiscale dependencies.
# Finally link tvb-multiscale from Github sources.
#

# Install NEST
ARG NEST_VER=3.9
ARG NEST_DESKTOP_HOST=0.0.0.0
ARG NEST_DESKTOP_PORT=8000
ARG NEST_SERVER_HOST=0.0.0.0
ARG NEST_SERVER_MODULES=nest,numpy
ARG NEST_SERVER_PORT=52425
ARG NEST_SERVER_RESTRICTION_OFF=1
ARG NEST_SERVER_STDOUT=1
FROM docker-registry.ebrains.eu/nest/nest-simulator:$NEST_VER


MAINTAINER lia.domide@codemart.ro

ENTRYPOINT []

USER root

RUN chmod a+x /root
RUN chmod -R a+rX /root/.env
# RUN chmod -R a+rX /root/.cache/music.install
RUN mkdir /opt/nest
RUN chmod -R a+rX /opt

RUN ln -s /root/.env/lib/nest /opt/nest/lib
RUN ln -s /root/.env/share/nest /opt/nest/share
RUN ln -s /root/.env/bin /opt/nest/bin
RUN ln -s /root/.env/lib/python3.12 /opt/nest/lib/python3.12
RUN ln -s /root/.cache/music.install /opt/music-install

# Activate the right python env.
ENV NEST_INSTALL_DIR=/opt/nest
RUN . ${NEST_INSTALL_DIR}/bin/nest_vars.sh
ENV NEST_PYTHON_PREFIX=${NEST_INSTALL_DIR}/lib/python3.12/site-packages
ENV PYTHONPATH=$PYTHONPATH:${NEST_PYTHON_PREFIX}
## Note that the following are automatically reset if NEST is imported
## via a call to  tvb_nest.simulator_nest.nest_factory.load_nest()
ENV NEST_DATA_DIR=${NEST_INSTALL_DIR}/share/nest
ENV SLI_PATH=${NEST_INSTALL_DIR}/share/nest/sli
ENV NEST_MODULE_PATH=${NEST_MODULE_PATH}
ENV LD_LIBRARY_PATH=${LD_LIBRARY_PATH}:${NEST_MODULE_PATH}
ENV NEST_DOC_DIR=${NEST_INSTALL_DIR}/share/doc/nest
ENV NESTML_MODULES_PATH=${NESTML_MODULES_PATH:-/tmp/nestmlmodules}

ENV NEST_DESKTOP_HOST=${NEST_DESKTOP_HOST:-0.0.0.0}
ENV NEST_DESKTOP_PORT=${NEST_DESKTOP_PORT:-8000}
ENV NEST_SERVER_HOST=${NEST_SERVER_HOST:-0.0.0.0}
ENV NEST_SERVER_MODULES=${NEST_SERVER_MODULES:-nest,numpy}
ENV NEST_SERVER_PORT=${NEST_SERVER_PORT:-52425}
ENV NEST_SERVER_RESTRICTION_OFF=${NEST_SERVER_RESTRICTION_OFF:-1}
ENV NEST_SERVER_STDOUT=${NEST_SERVER_STDOUT:-1}

#ENV MUSIC_ROOT_DIR=/opt/music-install
#ENV MUSIC_ROOT=${MUSIC_ROOT_DIR}
#ENV MUSIC_PATH=${MUSIC_ROOT_DIR}
#ENV LD_LIBRARY_PATH=${MUSIC_PATH}/lib:$LD_LIBRARY_PATH
#ENV PATH=${MUSIC_PATH}/bin:$PATH
#ENV CPATH=${MUSIC_PATH}/include:$CPATH
#ENV PYTHONPATH=$PYTHONPATH:${MUSIC_PATH}/lib/python3.12/site-packages

ENV PATH=$PATH:/usr/local/bin

#RUN sh /usr/local/bin/entrypoint.sh;

RUN apt-get update; apt-get install -y nodejs;  apt-get clean;

# Create user different than root
RUN useradd -ms /bin/bash docker
USER docker
ARG HOME=/home/docker
RUN mkdir $HOME/build; mkdir $HOME/packages
ENV PACKAGES=$HOME/packages
ENV BUILD=$HOME/build
ENV VENV=$HOME/venv
ENV DOTLOCALENV=$HOME/.local

RUN python3.12 -m venv $VENV && python3.12 -m venv --system-site-packages $VENV;

ENV PYTHONPATH=$VENV:$DOTLOCALENV:$PYTHONPATH
ENV PATH="${VENV}/bin":"${DOTLOCALENV}/bin":${PATH}

# Install NESTServerClient
WORKDIR $PACKAGES
RUN git clone https://github.com/nest/nest-client.git
RUN ln -s $PACKAGES/nest-client/nest-client.py $VENV/nest-client.py

# TODO: Find out if these are really needed:
RUN $VENV/bin/pip3 install --upgrade pip;
RUN $VENV/bin/pip3 install --upgrade nose;

# Install TVB-multiscale specific packages
WORKDIR $PACKAGES
# Install NEURON and NetPyNE
RUN $VENV/bin/pip3 install neuron
RUN $VENV/bin/pip3 install netpyne
# Install ANNarchy
RUN $VENV/bin/pip3 install ANNarchy==5.0.0rc10;
# Install pyNN
# RUN pip install pyNN
# Install Pyspike:
# Only via github:
# https://github.com/mariomulansky/PySpike/issues/82#issuecomment-2838013901
RUN $VENV/bin/pip3 install git+https://github.com/mariomulansky/PySpike.git;
# Install Elephant:
RUN $VENV/bin/pip3 install quantities neo elephant;

## Other (large) packages added for scientific work:
RUN $VENV/bin/pip3 install plotly;
# RUN $VENV/bin/pip3 install torch
# RUN $VENV/bin/pip3 install sbi
# RUN $VENV/bin/pip3 install sbibm

# Install TVB specific packages
WORKDIR $PACKAGES
RUN $VENV/bin/pip3 install pandas xarray pytest pytest-cov pytest-benchmark scikit-learn sqlalchemy numba dill; \
    $VENV/bin/pip3 install --ignore-installed entrypoints; \
    $VENV/bin/pip3 install werkzeug;

# Install some additional packages for TVB:
# For tvb-library:
RUN $VENV/bin/pip3 install deprecated autopep8 mako>=1.1.4 networkx numexpr cryptography pyaescrypt kubernetes;
# RUN $VENV/bin/pip3 install syncrypto
# for tvb-framework:
RUN $VENV/bin/pip3 install alembic bctpy cherrypy flask-restx formencode gevent nibabel;
RUN $VENV/bin/pip3 install python-keycloak requests-toolbelt>=0.10 siibra simplejson docutils;
RUN $VENV/bin/pip3 install tvb-data;  #  tvb-gdist;

# Clone and install tvb-root
WORKDIR $PACKAGES
RUN git clone --depth 1 --no-single-branch https://github.com/the-virtual-brain/tvb-root.git;
ARG LAST_SHA_TVB=LATEST
RUN cd tvb-root; \
    git pull --allow-unrelated-histories; \
    cd tvb_framework; \
    $VENV/bin/pip3 install -e . --no-deps; \
    cd ../tvb_storage; \
    $VENV/bin/pip3 install -e . --no-deps; \
    cd ../tvb_library; \
    $VENV/bin/pip3 install -e . --no-deps; \
    cd ../tvb_contrib; \
    $VENV/bin/pip3 install -e . --no-deps; \
    cd ../tvb_bin; \
    $VENV/bin/pip3 install -e .; \
    cd ../tvb_build; \
    $VENV/bin/pip3 install -e . --no-deps;

# Clone and install tvb-multiscale
WORKDIR $PACKAGES
RUN git clone --depth 1 --no-single-branch https://github.com/the-virtual-brain/tvb-multiscale.git;
ARG LAST_SHA_MULTISCALE=LATEST
RUN cd tvb-multiscale; \
    git pull origin --allow-unrelated-histories; \
    git checkout dev; \
    $VENV/bin/python3 setup.py develop --no-deps;

# Checkout specific branch of tvb-multiscale
# WORKDIR $PACKAGES
RUN cd tvb-multiscale; \
    git checkout dev; \
    git pull --allow-unrelated-histories;

# Compile tvb-netpyne .mod files
WORKDIR $PACKAGES
RUN cd tvb-multiscale; \
    $VENV/bin/nrnivmodl tvb_multiscale/tvb_netpyne/netpyne/mod;

## TODO: Solve problems with ray in this Docker image!
## Install ray:
RUN $VENV/bin/pip3 install -U "ray"

# Install Jupyter notebook specific packages
WORKDIR $PACKAGES
RUN $VENV/bin/pip3 install jupyterlab notebook ipympl;

WORKDIR $HOME

